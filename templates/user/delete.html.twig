{% extends 'base.html.twig' %}

{% block title %}Suppression Utilisateur{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        <h1>Vous souhaitez supprimer votre compte ?</h1>

        <form method="POST" action="{{ path('app_user_delete') }}">
            <label for="passEntry">Votre mot de passe : </label>
            <input type="password" id="passEntry" name="pass_entry" required>
            <input type="submit">
        </form>
    </div>
{% endblock %}