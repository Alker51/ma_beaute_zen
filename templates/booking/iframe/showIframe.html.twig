{% extends 'baseIframe.html.twig' %}

{% block body %}
    <h1> Rendez-vous #: {{ booking.id }}</h1>
        <table class="table">
            <tbody>
            <tr>
                <th>Titre</th>
                <td>{{ booking.title }}</td>
            </tr>
            <tr>
                <th>Date du Rendez-vous</th>
                <td>Le {{ booking.start ? booking.start|date('Y-m-d') : '' }}, de {{ booking.start ? booking.start|date('H:i') : '' }} à {{ booking.end ? booking.end|date('H:i') : '' }}</td>
            </tr>
            <tr>
                <th>État : </th>
                <td>{{ booking.state.name }}</td>
            </tr>
            <tr>
                <th>Client</th>
                <td>{{ booking.customer.firstName }} {{ booking.customer.lastName }}</td>
            </tr>
            <tr>
                <th>Employé attribué au Rendez-vous</th>
                <td>{{ booking.worker ? booking.worker.firstName ~ " " ~ booking.worker.lastName : "Aucun employé attribué pour le moment." }}</td>
            </tr>
            </tbody>
        </table>

        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-warning" href="{{ path('app_booking_edit', {'id': booking.id, 'from_iframe': 1}) }}">Modifier le rendez-vous.</a>
                {% include('booking/_delete_form.html.twig') with {'fromIframe': true} %}
                <a class="btn btn-success" href="{{ path('app_booking_validate', {'id': booking.id, 'from_iframe': 1}) }}">Confirmer le rendez-vous.</a>
            {% endif %}
        {% endif %}

        <a class="btn btn-info" href="{{ path('app_booking_calendarIframe') }}">Retour</a>
    <body>
{% endblock %}