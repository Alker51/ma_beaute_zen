{{ form_start(form) }}
    {{ form_row(form.title, { label: 'Titre du rendez-vous' }) }}
    {{ form_row(form.start, { label: 'Date & Heure de début' }) }}
    {{ form_row(form._token) }}
    {{ form_row(form.products, { label: 'Prestation voulue(s) lors du rendez-vous' }) }}
    {% if is_granted("ROLE_ADMIN") %}
        {{ form_row(form.worker, { label: 'Employé assigné à ce rendez-vous' }) }}
        {{ form_row(form.state, { label: 'Statut du Rendez-vous' }) }}
    {% endif %}
<button class="btn btn-success" type="submit">Réserver</button>
{{ form_end(form) }}

<script>
    document.addEventListener('turbo:load', function () {
        flatpickr("input[type=datetime-local]", {
            enableTime: true,
            locale: "fr",
            dateFormat: "Y-m-d\\TH:i",
            altFormat: "\\L\\e d F Y \\à H:i",
            altInput: true,
            time_24hr: true,
        });

        flatpickr("#booking_start", {
            enableTime: true,
            locale: "fr",
            dateFormat: "Y-m-d\\TH:i",
            altFormat: "\\L\\e d F Y \\à H:i",
            altInput: true,
            time_24hr: true,
        });
    });
</script>