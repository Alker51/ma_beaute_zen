{{ form_start(form) }}
    {{ form_row(form.title, { label: 'Titre du rendez-vous' }) }}
    {{ form_row(form.start, { label: 'Date & Heure de début' }) }}
    {{ form_row(form.end, { label: 'Date & Heure de fin' }) }}
    {{ form_row(form._token) }}
    {{ form_row(form.worker, { label: 'Employé assigné à ce rendez-vous' }) }}
    {{ form_row(form.state) }}
<button class="btn btn-success" type="submit">Confirmer</button>
{{ form_end(form) }}

<script>
    const now = new Date();

    let dateforFlatprickrStart = now.getFullYear() + "-" + (now.getMonth()+1) + "-" + now.getDate() + " " + now.getHours() + ":" + now.getMinutes();
    let dateforFlatprickrEnd = now.getFullYear() + "-" + (now.getMonth()+1) + "-" + now.getDate() + " " + (now.getHours()+1) + ":" + now.getMinutes();

    flatpickr("input[type=datetime-local]", {
        enableTime: true,
        locale: "fr",
        dateFormat: "Y-m-d\\TH:i",
        altFormat: "\\L\\e d F Y \\à H:i",
        altInput: true,
        time_24hr: true,
    });

    document.addEventListener('DOMContentLoaded', function () {
        flatpickr("#booking_start", {
            enableTime: true,
            locale: "fr",
            dateFormat: "Y-m-d\\TH:i",
            altFormat: "\\L\\e d F Y \\à H:i",
            altInput: true,
            time_24hr: true,
            defaultDate: dateforFlatprickrStart,
        });
        flatpickr("#booking_end", {
            enableTime: true,
            locale: "fr",
            dateFormat: "Y-m-d\\TH:i",
            altFormat: "\\L\\e d F Y \\à H:i",
            altInput: true,
            time_24hr: true,
            defaultDate: dateforFlatprickrEnd,
        });
    });

</script>