{% extends 'base.html.twig' %}

{% block title %}Prise de rendez-vous - Étape 2{% endblock %}

{% block body %}
    <h2>Étape 2 : Vos informations</h2>
    {{ form_start(form) }}
    {{ form_row(form.customerLastName) }}
    {{ form_row(form.customerFirstName) }}
    {{ form_row(form.customerEmail) }}
    {{ form_row(form.customerGender) }}
    {{ form_row(form.customerAdress) }}
    {{ form_row(form.customerZipCode) }}
    {{ form_row(form.customerCity) }}
    {{ form_row(form.customerPhone) }}
    {% if form.worker is defined %}
        {{ form_row(form.worker) }}
    {% endif %}
    {% if form.state is defined %}
        {{ form_row(form.state) }}
    {% endif %}
    {{ form_row(form._token) }}
    <button class="btn btn-success">Valider la réservation</button>
    {{ form_end(form, {'render_rest': false}) }}

{% endblock %}

