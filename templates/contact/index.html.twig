{% extends 'base.html.twig' %}

{% block title %}{{title}}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <table class="table">
        <thead>
        <tr>
            <th scope="col">Nom</th>
            <th scope="col">Statut</th>
            <th scope="col">Dernière modification le</th>
            <th scope="col"></th>
        </tr>
        </thead>
        <tbody>
        {% for contact in contacts %}
            <tr onclick="document.location = '{{ path('app_contact_detail', {'id' : contact.id}) }}';">
                <td>{{ contact.title }}</td>
                <td>
                    {% if contact.state.id == 1 %}
                         <span class="badge bg-primary">{{ contact.state.name }}</span>
                    {% elseif contact.state.id == 2 %}
                    <span class="badge bg-success">{{ contact.state.name }}</span>
                    {% else %}
                         <span class="badge bg-danger">{{ contact.state.name }}</span>
                    {% endif %}
                </td>
                <td> {{ contact.editedTime|date('d/m/Y H:s') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <br>
    <a href="{{ path('app_contact_create') }}" class="btn btn-primary">
        <i class="fa fa-plus"></i> Nouvelle demande
    </a>
{% endblock %}
