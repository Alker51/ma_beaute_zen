{% extends 'base.html.twig' %}

{% block title %}
    Votre prise de contacte du {{ contact.creationDate|date('d/m/Y') }}
{% endblock %}

{% block body %}
    <div>
        <h1>Votre prise de contacte</h1>
        <h1>{{ contact.title }}</h1>
        <h2>{{ contact.state }}</h2>
        <p>{{ contact.detail }}</p>
    </div>

    {% if contact.state.id == 1 %}
        <div>
            <a href="{{ path('app_reply', {'contactId' : contact.id}) }}" class="btn btn-primary">
                <i class="fa fa-comment-medical"></i> Répondre
            </a>
        </div>
    {% endif %}

    <div>
        <h1>Reponses</h1>

        {% if contactReplies is empty %}
            <p>Aucune reponse.</p>
        {% else %}
            {% for reply in contactReplies %}
                <strong>{{ reply.message }}</strong><br>
                <small>De
                    {% if reply.author is not null %}
                        <strong>{{ reply.author.firstname }} {{ reply.author.lastname }}</strong>
                    {% else %}
                        <strong>SAV</strong>
                    {% endif %}
                    <br>Date : {{ reply.replayDate|date('d/m/Y H:i') }}
                </small>
                {% if not loop.last %}
                    <br><hr>
                {% endif %}

            {% endfor %}
        {% endif %}
    </div>
{% endblock %}

