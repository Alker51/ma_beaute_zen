{% extends 'base.html.twig' %}

{% block title %}
    Votre prise de contacte du {{ contact.creationDate|date('d/m/Y') }}
{% endblock %}

{% block body %}
    <div>
        <h1>Votre prise de contacte</h1>
        <h1>{{ contact.title }}</h1>
        <h2>{{ contact.state }}</h2>
        <p>{{ contact.detail }}</p>
    </div>

    <div>
        <h1>Reponses</h1>

        {% if contactReplies is empty %}
            <p>Aucune reponse.</p>
        {% else %}
            {% for reply in contactReplies %}
                <p>{{ reply.replayDate|date('d/m/Y H:i') }}</p>
                <p>{{ reply.message }}</p>
            {% endfor %}
        {% endif %}
    </div>

{% endblock %}

