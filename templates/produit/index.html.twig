{% extends 'base.html.twig' %}

{% block title %}Liste des produits{% endblock %}

{% block body %}
    <h1>Liste des 50 derniers produits</h1>
    <table>
        <thead>
        <tr>
            <th>#</th>
            <th>Nom</th>
            <th>Description</th>
            <th>Prix HT</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for produit in produits %}
            <tr>
                <td>{{ produit.id }}</td>
                <td>{{ produit.name }}</td>
                <td>{{ produit.description|striptags }}</td>
                <td>{{ produit.priceHT }}</td>
                <td>
                    {{ produit.active ? 'Actif' : 'Inactif' }}
                </td>
                <td>
                    <a href="{{ path('app_produit_show', { id: produit.id }) }}">Voir</a>
                    <a href="{{ path('app_produit_edit', { id: produit.id }) }}">Modifier</a>
                    <a href="{{ path('app_produit_delete', { id: produit.id }) }}">Supprimer</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}

